# ===============================================================================
# TERMINAL ZERO - Environment Variables
# ===============================================================================
# Copy this file to .env and update the values for your environment.
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files with real secrets to version control.
# ===============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL Database
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=terminal_zero
POSTGRES_PORT=5432

# Full connection string (used by backend)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/terminal_zero

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
API_PORT=8000
DEBUG=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# JWT Authentication (legacy fallback)
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ---------------------------------------------------------------------------
# Supabase (Backend)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Bybit API (for market data)
# ---------------------------------------------------------------------------
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# BYBIT_TESTNET=true

# ---------------------------------------------------------------------------
# Upstash Redis (production; overrides REDIS_URL above)
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_URL=rediss://default:xxx@your-endpoint.upstash.io:6379

# ---------------------------------------------------------------------------
# Sentry (error tracking, optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# Dev Tools (start with: docker-compose --profile tools up)
# ---------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@terminalzero.io
PGADMIN_PASSWORD=admin
REDIS_COMMANDER_PORT=8081
