# ===============================================================================
# TERMINAL ZERO - Environment Variables
# ===============================================================================
# Copy this file to .env and update the values for your environment.
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files with real secrets to version control.
# ===============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL Database
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=terminal_zero
POSTGRES_PORT=5432

# Full connection string (used by backend)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/terminal_zero

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
API_PORT=8000
DEBUG=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Persistent background workers (streaming + scheduled jobs).
# Auto-disabled on Vercel (serverless). Set true on the VPS / Railway.
ENABLE_BACKGROUND_WORKERS=true

# JWT Authentication (legacy fallback)
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ---------------------------------------------------------------------------
# Supabase (Backend)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Stripe Billing
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...
STRIPE_ELITE_ANNUAL_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------------
# Bybit API (for market data)
# ---------------------------------------------------------------------------
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# BYBIT_TESTNET=true

# ---------------------------------------------------------------------------
# Upstash Redis (production; overrides REDIS_URL above)
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_URL=rediss://default:xxx@your-endpoint.upstash.io:6379

# ---------------------------------------------------------------------------
# Sentry (error tracking, optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# Paystack (Nigeria/Africa payments)
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# ---------------------------------------------------------------------------
# AI Coaching (Claude API)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Firebase Auth (identity provider — verified in the API layer)
# ---------------------------------------------------------------------------
# Backend only needs the (public) project id to verify ID tokens against
# Google's public certs. No service-account JSON required for verification.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: override the deterministic Firebase-UID -> Supabase-UUID namespace.
# FIREBASE_UID_NAMESPACE=8f1d4c2e-0b3a-4c5d-9e6f-1a2b3c4d5e6f

# Frontend Firebase web config (all public; safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Cloud Messaging (push notifications) — optional
# FIREBASE_SERVER_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2 object storage (Parquet historicals + screenshots; S3-compatible)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=terminal-zero
# R2_ENDPOINT defaults to https://<account-id>.r2.cloudflarestorage.com
# R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# AI coach (DeepSeek V4 Flash via an OpenAI-compatible interface)
# Gated to paid school tiers. Swappable to a self-hosted model later.
# ---------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------------------------------------------------------------------------
# Email (Resend or SendGrid for auth emails)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....
# FROM_EMAIL=noreply@terminalzero.com

# ---------------------------------------------------------------------------
# Frontend URL (used by Stripe portal redirect)
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Dev Tools (start with: docker-compose --profile tools up)
# ---------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@terminalzero.io
PGADMIN_PASSWORD=admin
REDIS_COMMANDER_PORT=8081
