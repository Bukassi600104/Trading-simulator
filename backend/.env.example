# Environment Configuration
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terminal_zero
DEBUG=true

# Persistent background workers (streaming + scheduled jobs).
# Auto-disabled on Vercel (serverless); set true on the VPS / Railway.
ENABLE_BACKGROUND_WORKERS=true

# Firebase Auth (identity) — only the public project id is needed to verify
# Google-signed ID tokens. No service-account JSON required for verification.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Supabase (relational app data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Cloudflare R2 object storage (Parquet historicals + screenshots)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=terminal-zero
R2_PUBLIC_BASE_URL=

# AI coach (DeepSeek V4 Flash via OpenAI-compatible interface; paid-tier gated)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Paystack (school-level billing)
PAYSTACK_SECRET_KEY=sk_test_...

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...
STRIPE_ELITE_ANNUAL_PRICE_ID=price_...

# AI Coaching (Claude API)
ANTHROPIC_API_KEY=sk-ant-...
